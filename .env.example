# Postgres connection (Neon for managed, local docker for self-host)
DATABASE_URL="postgres://root:mysecretpassword@localhost:5433/local"

# GitHub token for public routes and dev (fine-grained PAT). Optional, but without
# it anonymous visitors only get GitHub's small rate limit until they sign in
GITHUB_TOKEN=""

# GitHub OAuth app, enables "Login with GitHub" for higher per-user rate limits
# Leave blank to run on GITHUB_TOKEN alone
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Secret used to encrypt the session cookie, required once OAuth is enabled
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Optional overrides
# GITHUB_API="https://api.github.com"
# GITHUB_GRAPHQL="https://api.github.com/graphql"
# CACHE_TTL_SECONDS=900
# GITHUB_OAUTH_AUTHORIZE="https://github.com/login/oauth/authorize"
# GITHUB_OAUTH_TOKEN="https://github.com/login/oauth/access_token"
